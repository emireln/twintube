# TwinTube VPS Production Environment Configuration

# Server Port
PORT=8080

# Database Engine ("postgres" or "sqlite")
DB_TYPE=postgres

# PostgreSQL Connection URL
DATABASE_URL=postgres://twintube_user:twintube_secure_password@postgres:5432/twintube_db?sslmode=disable

# PostgreSQL Credentials (alternative if DATABASE_URL is not set)
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=twintube_user
POSTGRES_PASSWORD=twintube_secure_password
POSTGRES_DB=twintube_db
POSTGRES_SSLMODE=disable

# JWT Auth Secret Key (Set a random string on VPS!)
JWT_SECRET=your_super_secret_vps_jwt_signing_key_here
