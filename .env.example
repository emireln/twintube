# TwinTube VPS Production Environment Configuration

# Server Port
PORT=8080

# Database Engine ("postgres" or "sqlite")
DB_TYPE=postgres

# PostgreSQL Connection URL
DATABASE_URL=postgres://twintube_user:CHANGE_ME_STRONG_DB_PASSWORD@postgres:5432/twintube_db?sslmode=disable

# PostgreSQL Credentials (alternative if DATABASE_URL is not set)
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=twintube_user
POSTGRES_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD
POSTGRES_DB=twintube_db
POSTGRES_SSLMODE=disable

# JWT Auth Secret Key (generate with: openssl rand -hex 32)
JWT_SECRET=CHANGE_ME_GENERATE_A_RANDOM_SECRET

# Desktop installer directory (served at /downloads/)
# DOWNLOADS_DIR=./downloads

# User avatar uploads (served at /uploads/avatars/)
# AVATARS_DIR=./uploads/avatars

# Optional WebRTC / coturn (push-to-talk voice)
# STUN_URL=stun:stun.l.google.com:19302
# TURN_HOST=turn.twintube.site
# TURN_SECRET=change_me_to_a_long_random_turn_secret
# TURN_REALM=twintube
# TURN_TTL_SECONDS=3600
# TURN_TLS=false
# Coturn shared secret must match TURN_SECRET above (use-auth-secret / static-auth-secret).
