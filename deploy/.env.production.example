# Copy to /opt/twintube/.env on the VPS (never commit real values)

PORT=8080
DB_TYPE=postgres

POSTGRES_USER=twintube_user
POSTGRES_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD
POSTGRES_DB=twintube_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_SSLMODE=disable

DATABASE_URL=postgres://twintube_user:CHANGE_ME_STRONG_DB_PASSWORD@postgres:5432/twintube_db?sslmode=disable

# Random 64+ char string — openssl rand -hex 32
JWT_SECRET=CHANGE_ME_JWT_SECRET

# Let's Encrypt notifications
ACME_EMAIL=you@twintube.site

# Public domain (used for WebSocket origin checks)
APP_DOMAIN=twintube.site
